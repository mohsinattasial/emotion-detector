import cv2
import numpy as np
import os
import urllib.request

# --- 1. Settings & Model Config ---
# We use the FER+ model (Lightweight, fast, 8 emotions)
MODEL_URL = "https://huggingface.co/onnxmodelzoo/emotion-ferplus-8/resolve/main/emotion-ferplus-8.onnx"
MODEL_FILENAME = "emotion-ferplus-8.onnx"
EMOTIONS = ['Neutral', 'Happy', 'Surprise', 'Sad', 'Angry', 'Disgust', 'Fear', 'Contempt']

def download_model_if_missing():
    """Downloads the ONNX model if it doesn't exist locally."""
    if not os.path.exists(MODEL_FILENAME):
        print(f"Model not found. Downloading {MODEL_FILENAME} (35MB)...")
        try:
            urllib.request.urlretrieve(MODEL_URL, MODEL_FILENAME)
            print("Download complete!")
        except Exception as e:
            print(f"Error downloading model: {e}")
            print(f"Please manually download: {MODEL_URL}")
            exit()
    else:
        print("Model found locally.")

def main():
    # 1. Setup
    download_model_if_missing()
    
    # Load the Network using OpenCV's DNN module (No PyTorch/TF needed)
    net = cv2.dnn.readNetFromONNX(MODEL_FILENAME)
    
    # Load Face Detector (Haar Cascade - built into OpenCV)
    face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')

    # 2. Open Webcam
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("Error: Webcam not found.")
        return

    print("Running... Press 'q' to quit.")

    while True:
        ret, frame = cap.read()
        if not ret:
            break
            
        # Flip frame for mirror effect
        frame = cv2.flip(frame, 1)
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        # 3. Detect Faces
        faces = face_cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(30, 30))

        if len(faces) == 0:
            cv2.putText(frame, "No Face Detected", (20, 50), cv2.FONT_HERSHEY_SIMPLEX, 
                        1, (0, 0, 255), 2)

        for (x, y, w, h) in faces:
            # Draw box
            cv2.rectangle(frame, (x, y), (x+w, y+h), (255, 0, 0), 2)

            # 4. Preprocess Face for Model
            roi_gray = gray[y:y+h, x:x+w]
            
            # The FER+ model expects 64x64 input
            roi_resized = cv2.resize(roi_gray, (64, 64))
            
            # Preprocess: Normalize and reshape to (1, 1, 64, 64)
            # blobFromImage handles mean subtraction and scaling
            blob = cv2.dnn.blobFromImage(roi_resized, 1.0, (64, 64), (0, 0, 0), swapRB=False, crop=False)
            
            # 5. Predict Emotion
            net.setInput(blob)
            predictions = net.forward()
            
            # Get the highest score
            emotion_index = np.argmax(predictions[0])
            emotion_text = EMOTIONS[emotion_index]
            confidence = predictions[0][emotion_index]

            # 6. Display Result
            label = f"{emotion_text}: {confidence:.2f}"
            cv2.putText(frame, label, (x, y - 10), cv2.FONT_HERSHEY_SIMPLEX, 
                        0.8, (0, 255, 0), 2)

        cv2.imshow('Emotion Detection (OpenCV Only)', frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
    
